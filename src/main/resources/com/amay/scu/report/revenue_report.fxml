<GridPane prefHeight="828.0" prefWidth="1536.0" styleClass="bg-surface" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.amay.scu.report.controller.RevenueReportsController">

    <columnConstraints>
        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
    </columnConstraints>
    <rowConstraints>
        <RowConstraints minHeight="10.0" percentHeight="15.0" prefHeight="30.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="10.0" percentHeight="8.0" prefHeight="30.0" vgrow="SOMETIMES" />
    </rowConstraints>
    <HBox alignment="CENTER_LEFT" spacing="30.0" GridPane.halignment="CENTER" GridPane.rowIndex="2" GridPane.valignment="CENTER">
        <GridPane.margin>
            <Insets left="25.0" />
        </GridPane.margin>
        <Button fx:id="refresh" mnemonicParsing="false" onAction="#onClickRefresh" prefHeight="44.0" prefWidth="44.0">
            <styleClass>
                <String fx:value="rounded" />
                <String fx:value="success" />
            </styleClass>
            <graphic>
                <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                    <effect>
                        <ColorAdjust brightness="1.0" />
                    </effect>
                    <Image url="@../images/refresh.png" />
                </ImageView>
            </graphic>
        </Button>
        <Label text="Export As :">
            <styleClass>
                <String fx:value="caption-menu-item" />
                <String fx:value="text-caption" />
            </styleClass>
        </Label>
        <Button fx:id="btnPdf" mnemonicParsing="false" text="PDF">
            <styleClass>
                <String fx:value="success" />
                <String fx:value="text-caption" />
            </styleClass>
            <graphic>
                <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/pdf-file.png" />
                    </image>
                    <effect>
                        <ColorAdjust brightness="1.0" contrast="-1.0" hue="-1.0" saturation="1.0" />
                    </effect>
                </ImageView>
            </graphic>
        </Button>
        <Button fx:id="btnExcel" mnemonicParsing="false" text="Excel">
            <styleClass>
                <String fx:value="success" />
                <String fx:value="text-caption" />
            </styleClass>
            <graphic>
                <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/excel.png" />
                    </image>
                    <effect>
                        <ColorAdjust brightness="1.0" />
                    </effect>
                </ImageView>
            </graphic>
        </Button>
        <Pagination maxPageIndicatorCount="5" pageCount="5" prefHeight="200.0" prefWidth="200.0" GridPane.rowIndex="2">
            <GridPane.margin>
                <Insets left="25.0" right="25.0" />
            </GridPane.margin>
        </Pagination>
      <Button fx:id="filter" mnemonicParsing="false" text="Filters">
         <styleClass>
            <String fx:value="success" />
            <String fx:value="text-caption" />
         </styleClass>
         <graphic>
            <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/pdf-file.png" />
               </image>
               <effect>
                  <ColorAdjust brightness="1.0" contrast="-1.0" hue="-1.0" saturation="1.0" />
               </effect>
            </ImageView>
         </graphic>
      </Button>

      <FlowPane fx:id="chipperBucket" prefHeight="28.0" prefWidth="496.0" />
    </HBox>
