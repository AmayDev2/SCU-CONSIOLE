    <TableView fx:id="reportsTable" prefHeight="200.0" prefWidth="200.0" GridPane.columnSpan="2147483647" GridPane.rowIndex="1">
        <GridPane.margin>
          <Insets left="25.0" right="25.0" />
        </GridPane.margin>
    </TableView>

    <GridPane fx:id="filtersGridView" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="4" GridPane.halignment="CENTER" GridPane.valignment="CENTER">
        <columnConstraints>
            <ColumnConstraints  hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
      <children>
         <VBox  GridPane.columnIndex="3" spacing="10" alignment="CENTER" >
             <TextField fx:id="filterField"  maxWidth="175"  promptText="Search By..."  />
             <DatePicker fx:id="fromDatePicker"/>
             <DatePicker fx:id="toDatePicker"  />
         </VBox>
      </children>
