<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<Button fx:id="ag" styleClass="ag" stylesheets="@../css/sles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.amay.scu.controller.AGController">

    <graphic>
        <HBox alignment="CENTER" spacing="5.0">
            <Label fx:id="inCount" styleClass="passengerCountLabel" stylesheets="@../css/sle-name.css" text="X" />
        <VBox fx:id="agBackground" alignment="CENTER" >
            <ImageView fitWidth="130.0" preserveRatio="true" visible="true">
                <image>
                    <Image url="@../images/gates/IDO.png" />
                </image>
            </ImageView>
            <StackPane alignment="BOTTOM_CENTER">
               <children>
                  <ImageView fx:id="imageView" fitWidth="130.0" preserveRatio="true">
                      <image>
                          <Image url="@../images/gates/Bi_D_not_working.png" />
                      </image>
                  </ImageView>
                  <Label fx:id="name" stylesheets="@../css/sle-name.css" text="AG" />
               </children>
            </StackPane>
        </VBox>
            <Label fx:id="outCount" styleClass="passengerCountLabel" stylesheets="@../css/sle-name.css" text="Y" />
        </HBox>
    </graphic>

</Button>
